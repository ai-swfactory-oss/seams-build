{
  "name": "@ai-swfactory-oss/typescript",
  "description": "A pure TypeScript library: type-checks and emits the sources of a Tree in-process, and returns its diagnostics and emitted outputs as plain data.",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory-oss/seams-build.git",
    "directory": "packages/typescript"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tgz"
  ],
  "dependencies": {
    "@ai-swfactory-oss/files": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
